                <action id="0" name="Set text" sid="849581634781448" type="Txt_SubjudulMateri">
                    <param id="0" name="Text">&quot;1. Mengapa Kita Harus Memilah Sampah?&quot;</param>
                </action>
                <action id="0" name="Set text" sid="984262784193904" type="Txt_IsiMateri">
                    <param id="0" name="Text">&quot;Setiap hari kita menghasilkan sampah dari sisa makanan dan kemasan jajan.&quot; &amp; newline &amp; newline &amp; &quot;Jika dicampur, sampah menjadi bau, kotor, dan mencemari lingkungan sekolah. Dengan memilahnya, sampah bisa diolah kembali!&quot;</param>
                </action>
