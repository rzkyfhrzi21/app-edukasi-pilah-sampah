                <action id="0" name="Set text" sid="182887372783811" type="Txt_SubjudulMateri">
                    <param id="0" name="Text">&quot;2. Sampah Organik (Tong Hijau)&quot;</param>
                </action>
                <action id="0" name="Set text" sid="833389568354571" type="Txt_IsiMateri">
                    <param id="0" name="Text">&quot;Sampah organik berasal dari makhluk hidup (alam) sehingga mudah membusuk dan terurai tanah.&quot; &amp; newline &amp; newline &amp; &quot;Contoh: Sisa buah apel, kulit pisang, daun kering, dan sisa sayur.&quot; &amp; newline &amp; &quot;Manfaat: Bisa diolah menjadi pupuk kompos untuk tanaman sekolah.&quot;</param>
